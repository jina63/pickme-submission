PUBLIC_BASE_URL=
PICKME_FIREBASE_DATABASE_URL=
PICKME_FIREBASE_WEB_API_KEY=

# Gmail SMTP: 앱 비밀번호만 사용, 실제 값은 .env에 직접 입력
PICKME_GMAIL_USER=sender@example.invalid
PICKME_GMAIL_APP_PASSWORD=
PICKME_CONTACTS_FILE=

# 카카오 로컬 API(주변 주차장 추천): 카카오 개발자 앱의 REST API 키. 실제 값은 .env에만 입력
KAKAO_REST_API_KEY=

# Private mail recipients; use the same neutral contact labels shown in demo-contacts.json
PICKME_MAIL_RECIPIENTS_JSON=
